# Postgres connection string (Supabase)
DATABASE_URL=

# Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Object storage bucket for HTML and screenshots. Never commit the objects.
EVIDENCE_BUCKET=

# Transactional email placeholder (Resend). Alerts are not sent in this skeleton.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Shared secret for a scheduler calling an internal route, when one exists.
CRON_SECRET=

# Meta Graph API. Unused until the owner creates a Meta app and it passes app review.
# Do not put a personal Instagram password here. There is no Meta login in this app.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
